# pgBackRest repository settings, read only while BACKUP_ENABLED=true in .env.
# Copy to .env.backup next to .env on the deploy box and keep it chmod 600.
# Compose loads it into the postgres container and the backup sidecar alone,
# never into the app, worker or scheduler.
#
# Values are written bare: no quotes, no "$", no "#". compose env_file and
# `docker run --env-file` read those differently, and check_env.py refuses them.

# Hetzner Object Storage: endpoint without a scheme, e.g. nbg1.your-objectstorage.com,
# region nbg1.
PGBACKREST_REPO1_S3_BUCKET=
PGBACKREST_REPO1_S3_ENDPOINT=
PGBACKREST_REPO1_S3_REGION=
PGBACKREST_REPO1_S3_KEY=backup-s3-key-not-real
PGBACKREST_REPO1_S3_KEY_SECRET=backup-s3-secret-not-real
# Encrypts every backup and WAL segment in the bucket; losing it loses them all.
# Generate with `openssl rand -hex 32` and keep a copy outside the box.
PGBACKREST_REPO1_CIPHER_PASS=backup-cipher-pass-not-real

# Heartbeat URLs pinged by the backup and archive-check jobs; empty disables them.
BACKUP_HEARTBEAT_URL=
BACKUP_ARCHIVE_HEARTBEAT_URL=
